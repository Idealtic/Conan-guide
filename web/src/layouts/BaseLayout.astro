---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = "Tra cứu tập phim Conan - Conan Guide",
  description = "Ứng dụng tra cứu danh sách tập phim Thám Tử Lừng Danh Conan theo số tập JP/VN, Canon/Filler, Arc, manh mối và nhân vật.",
  currentPath = Astro.url.pathname,
} = Astro.props;
---

<!doctype html>
<html lang="vi" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🔍</text></svg>" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="min-h-full flex flex-col bg-[#F8F9FA] text-[#212529] font-sans antialiased">
    <Navbar currentPath={currentPath} />
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <slot />
    </main>
    <Footer />
  </body>
</html>
