---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/prose.css";
import Content from "../content/gioi-thieu.mdx";
---

<BaseLayout
  title="Giới thiệu dự án - Conan Guide"
  description="Giới thiệu mục tiêu, nguồn dữ liệu và công nghệ phát triển dự án Conan Episode Guide."
  currentPath="/gioi-thieu"
>
  <div class="max-w-3xl mx-auto py-2 sm:py-4">
    <div class="bg-white rounded-xl shadow-xs border border-[#DEE2E6] p-4 sm:p-10">
      <article class="prose prose-slate prose-a:text-blue-600 hover:prose-a:text-blue-800 max-w-none text-sm leading-relaxed space-y-4">
        <Content />
      </article>
    </div>
  </div>
</BaseLayout>
